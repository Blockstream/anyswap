{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/api.ts",
    "src/wallet.ts",
    "src/context.ts",
    "src/driver.ts",
    "src/esplora.ts",
    "src/utils.ts",
    "src/types.ts"
  ],
  "entryPointStrategy": "expand",
  "tsconfig": "./tsconfig.json",
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "out": "../sdk-docs/docs/typescript/reference",
  "entryFileName": "Reference.md",
  "readme": "none",
  "outputFileStrategy": "modules",
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  "hidePageTitle": true,
  "disableSources": true,
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeNotDocumented": false,
  "excludeTags": [
    "@format",
    "@default"
  ],
  "useCodeBlocks": true,
  "useHTMLAnchors": false,
  "expandObjects": true,
  "expandParameters": true,
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table",
  "classPropertiesFormat": "table",
  "typeDeclarationFormat": "table",
  "typeAliasPropertiesFormat": "table",
  "enumMembersFormat": "table",
  "indexFormat": "list",
  "githubPages": false,
  "gitRevision": "master",
  "cleanOutputDir": true,
  "useHTMLEncodedBrackets": true,
  "blockTags": [
    "@param",
    "@returns",
    "@return",
    "@typeParam",
    "@template",
    "@module",
    "@packageDocumentation",
    "@group",
    "@category",
    "@groupDescription",
    "@categoryDescription",
    "@see",
    "@example",
    "@remarks",
    "@privateRemarks",
    "@throws",
    "@defaultValue",
    "@default",
    "@deprecated",
    "@author",
    "@since",
    "@satisfies",
    "@type",
    "@property",
    "@prop",
    "@document",
    "@import",
    "@min",
    "@max",
    "@format",
    "@pattern",
    "@minItems",
    "@maxItems"
  ]
}
